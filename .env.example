# Placeholders only -- never put real credentials in this file.
# Copy to .env (git-ignored) for local runs; in production set these in the Render dashboard.

KC_DB=identity-server

KC_DB_URL=jdbc:postgresql://<db-host>:5432/identity-server?sslmode=require

KC_DB_USERNAME=<db-username>

KC_DB_PASSWORD=changeme

# Use a non-default username and a strong generated password (never admin/admin).
KC_BOOTSTRAP_ADMIN_USERNAME=<bootstrap-admin-username>

KC_BOOTSTRAP_ADMIN_PASSWORD=changeme

KC_HOSTNAME=http://localhost:8080

KC_HTTP_ENABLED=true
